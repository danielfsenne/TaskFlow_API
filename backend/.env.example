NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taskflow:taskflow@localhost:5433/taskflow?schema=public
CORS_ORIGIN=http://localhost:4200

# Gere segredos com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-por-outro-segredo-com-no-minimo-32-caracteres
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Tentativas por minuto, por IP, em login, cadastro e recuperação de senha
THROTTLE_AUTH_LIMIT=10
# true quando a API fica atrás de proxy (nginx, load balancer)
TRUST_PROXY=false

# Endereço do frontend, usado no link de redefinição de senha
APP_URL=http://localhost:4200
# Em desenvolvimento, o Mailpit do docker compose recebe os e-mails (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM=TaskFlow <nao-responda@taskflow.local>

# Pasta onde ficam as fotos de perfil
# Fotos e anexos: local (pasta UPLOAD_DIR) ou s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# S3_BUCKET=taskflow
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9090
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Busca por tarefas que vencem nas próximas 24 h, em minutos (0 desliga)
REMINDERS_INTERVAL_MINUTES=15
